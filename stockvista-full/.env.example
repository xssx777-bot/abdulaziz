# Copy to .env.local before running. Never commit the filled-in file.

# --- Required ---------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace_me_with_a_random_secret
NEXTAUTH_URL=http://localhost:3000

# Prisma's CLI reads .env, not .env.local — put this in both.
DATABASE_URL="file:./dev.db"

# --- Market data (optional) -------------------------------------------------
# Without a key the app serves sample quotes, labelled `source: "sample"` in
# every response. Set the key and the same routes go live with no code change.
# The default base URL targets Twelve Data, which covers US venues and Tadawul.
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://api.twelvedata.com
MARKET_DATA_CACHE_SECONDS=30

# --- Interactive Brokers (optional) -----------------------------------------
# IBKR has no cloud API to point a key at. The Client Portal API is served by a
# gateway you run and log into interactively; this is that gateway's address.
# One gateway per account, kept logged in — an operational commitment, not just
# a credential. Leave blank to serve sample accounts and positions.
IBKR_GATEWAY_URL=
# The gateway ships with a self-signed certificate. Only set this false against
# a gateway you control, never in production.
IBKR_REJECT_UNAUTHORIZED=true

# --- Stripe (optional) ------------------------------------------------------
# Without a secret key the checkout route answers 503 rather than pretending.
STRIPE_SECRET_KEY=
# From `stripe listen` in development, or the endpoint's signing secret in the
# dashboard. The webhook refuses to run without it — unverified events are how
# someone upgrades themselves for free.
STRIPE_WEBHOOK_SECRET=
# Price IDs from the Stripe dashboard (they start with price_).
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
